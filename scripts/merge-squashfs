# Merge an overlay directory into a squashfs
#
# Usage: merge-squashfs input.squashfs output.squashfs overlay-dir squashfs-priorities
#

set -e

LC_ALL=C
LANG=C
export LC_ALL LANG

# Account for Mac differences
if [[ "$(uname)" = "Darwin" ]]; then
    # Use gstat on the Mac, but make sure that it exists first.
    STAT=$(command -v gstat || echo "/usr/local/bin/gstat")
    if [[ ! -e "$STAT" ]]; then
        echo "merge-squashfs: ERROR: Please install gstat first"
        echo
        echo "For example:"
        echo "   brew install coreutils"
        exit 1
    fi
else
    STAT="$(command -v stat)"
fi

# This implementation might be slow
# Both listings in one pass of awk each: the shell loops they replace started
# several processes per file (sed, stat, command substitutions), ~40 s for a
# typical Nerves image.
unsquash_to_pseudofile() {
    unsquashfs -n -ll "$1" | awk '
    function perm_to_num(s,   p, c) {
        p = 0
        if (substr(s, 2, 1) == "r") p += 256
        if (substr(s, 3, 1) == "w") p += 128
        c = substr(s, 4, 1)
        if (c == "x") p += 64; else if (c == "s") p += 2112; else if (c == "S") p += 2048
        if (substr(s, 5, 1) == "r") p += 32
        if (substr(s, 6, 1) == "w") p += 16
        c = substr(s, 7, 1)
        if (c == "x") p += 8; else if (c == "s") p += 1032; else if (c == "S") p += 1024
        if (substr(s, 8, 1) == "r") p += 4
        if (substr(s, 9, 1) == "w") p += 2
        c = substr(s, 10, 1)
        if (c == "x") p += 1; else if (c == "t") p += 513; else if (c == "T") p += 512
        return sprintf("%o", p)
    }
    function replace_all(s, from, to,   out, i) {
        out = ""
        while ((i = index(s, from)) > 0) {
            out = out substr(s, 1, i - 1) to
            s = substr(s, i + length(from))
        }
        return out s
    }
    # The path without its squashfs-root prefix, spaces escaped
    function get_path(s,   i) {
        if ((i = index(s, "squashfs-root")) > 0)
            s = substr(s, 1, i - 1) substr(s, i + 13)
        return replace_all(s, " ", "\\ ")
    }
    function words_from(n,   s, i) {
        s = $n
        for (i = n + 1; i <= NF; i++) s = s " " $i
        return s
    }
    function owner(s) { return replace_all(s, "/", " ") }
    {
        type = substr($1, 1, 1)
        if (type == "c" || type == "b") {
            # unsquashfs prints device numbers as "major,minor" or "major, minor"
            if ($3 ~ /,./) {
                major_minor = $3; filename = $6
            } else {
                major_minor = $3 " " $4; filename = $7
            }
            sub(/,/, " ", major_minor)
            print get_path(filename) " " type " " perm_to_num($1) " " owner($2) " " major_minor
        } else if (type == "l") {
            print get_path($6) " m " perm_to_num($1) " " owner($2)
        } else if (type == "d" || type == "-") {
            path = get_path(words_from(6))
            # mksquashfs cannot set permissions on the root directory
            if (type == "-" || path != "")
                print path " m " perm_to_num($1) " " owner($2)
        }
    }'
}

find_to_pseudofile() {
    find "$1" -exec "$STAT" -c "%a %n" "{}" "+" | awk -v dir="$1" '
    {
        mode = $1
        path = substr($0, index($0, " ") + 1)
        sub(/^[ \t]+/, "", path)
        sub(/[ \t]+$/, "", path)
        if ((i = index(path, dir)) > 0)
            path = substr(path, 1, i - 1) substr(path, i + length(dir))
        out = ""
        while ((i = index(path, " ")) > 0) {
            out = out substr(path, 1, i - 1) "\\ "
            path = substr(path, i + 1)
        }
        path = out path
        if (path != "")
            print path " m " mode " 0 0"
    }'
}

# "readlink -f" implementation for BSD
# This code was extracted from the Elixir shell scripts
readlink_f () {
    cd "$(dirname "$1")" > /dev/null
    filename="$(basename "$1")"
    if [[ -h "$filename" ]]; then
        readlink_f "$(readlink "$filename")"
    else
        echo "$(pwd -P)/$filename"
    fi
}

if [[ $# -lt 4 ]]; then
    echo "Usage: merge-squashfs input.squashfs output.squashfs overlay-dir squashfs_priorities"
    exit 1
fi

input_squashfs=$(readlink_f "$1")
output_squashfs=$(readlink_f "$2")
overlay_dir=$(readlink_f "$3")
squashfs_priorities=$(readlink_f "$4")

if [[ ! -f $input_squashfs ]]; then
    echo "Can't open $input_squashfs"
    exit 1
fi
if [[ ! -d $overlay_dir ]]; then
    echo "Can't find $overlay_dir"
    exit 1
fi

# Use $TMPDIR if it's set
if [[ -e "$TMPDIR" ]]; then
    workdir=$(mktemp -d "$TMPDIR/merge-squashfs-tmp.XXXXXXXXXX")
else
    workdir=$(mktemp -d)
fi

pushd "$workdir" >/dev/null

unsquash_to_pseudofile "$input_squashfs" >pseudofile.in
find_to_pseudofile "$overlay_dir" >>pseudofile.in

# remove repeated entries to avoid warnings from mksquashfs
awk '!x[$1]++' pseudofile.in > pseudofile

unsquashfs -f "$input_squashfs" >/dev/null
cp -Rf "$overlay_dir/." "$workdir/squashfs-root"
mksquashfs squashfs-root "$output_squashfs" -pf pseudofile -sort "$squashfs_priorities" -noappend -no-recovery -no-progress $NERVES_MKSQUASHFS_FLAGS

# cleanup
popd >/dev/null
rm -fr "$workdir"
